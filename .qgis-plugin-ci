# Configuration for qgis-plugin-ci (https://qgis.github.io/qgis-plugin-ci/).
# Drives .github/workflows/publish.yml: it builds the plugin zip from pyramids_qgis/ and, with
# --github-token, uploads it as a GitHub Release asset.
plugin_path: pyramids_qgis
github_organization_slug: serapeum-org
project_slug: pyramids-qgis
# changelog injection is OFF: commitizen owns CHANGELOG.md and emits its native "## vX.Y.Z (date)"
# format, which qgis-plugin-ci's CHANGELOG_REGEXP (requiring a "## [x.y.z] - YYYY-MM-DD" style with a
# " - <date>") does not match — leaving it on would silently inject an EMPTY changelog into
# metadata.txt. To populate the Plugin Manager changelog later, emit a Keep-a-Changelog-format file
# (e.g. a commitizen template with "## [x.y.z] - <date>" headings) and flip this back to true.
changelog_include: false
